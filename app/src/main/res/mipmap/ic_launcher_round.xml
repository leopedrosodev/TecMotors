<?xml version="1.0" encoding="utf-8"?>
<!-- Icone para API 24-25, que nao tem icone adaptativo. Em API 26+ o sistema
     usa mipmap-anydpi-v26/ic_launcher.xml no lugar deste. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_background" />
        </shape>
    </item>
    <item
        android:width="30dp"
        android:height="30dp"
        android:gravity="center"
        android:drawable="@drawable/ic_tecmotors_mark" />
</layer-list>
