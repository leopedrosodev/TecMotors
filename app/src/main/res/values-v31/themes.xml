<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ e a unica versao em que a splash do sistema anima o icone.
     Aqui a marca entra torta e menor e assenta, com a fresta ambar acendendo
     no fim. Em versoes anteriores vale o tema de values/, com a marca parada. -->
<resources>

    <style name="Theme.TecMotors.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="postSplashScreenTheme">@style/Theme.TecMotors</item>

        <item name="android:windowSplashScreenBackground">@color/brand_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="android:windowSplashScreenAnimationDuration">700</item>
    </style>

</resources>
