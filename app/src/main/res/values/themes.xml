<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema da janela apos o splash. Fundo igual ao background escuro do Compose
         para nao existir flash branco entre a splash e o primeiro frame da UI. -->
    <style name="Theme.TecMotors" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Tema de abertura: e o que o sistema desenha desde o primeiro frame,
         antes do processo terminar de subir. -->
    <style name="Theme.TecMotors.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.TecMotors</item>
    </style>

</resources>
