rules_version = '2';

// Regras do Firestore do TecMotors.
//
// O app grava um unico documento por usuario em tec_motors_users/{uid}, onde
// uid e o do Firebase Auth (ver SyncRepositoryImpl). Entao a regra e direta:
// cada conta so alcanca o proprio documento.
//
// Nao existe regra coringa aqui de proposito. No Firestore tudo que nao e
// liberado explicitamente ja e negado, entao qualquer outra colecao fica
// fechada - inclusive as que vierem a existir por engano.
//
// Como aplicar: console do Firebase -> Firestore -> Regras -> colar -> publicar.
// Ou, com a CLI: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    match /tec_motors_users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }
  }
}
